{
  "name": "@framers/sql-storage-adapter",
  "version": "0.7.10",
  "description": "Robust cross-platform SQL storage abstraction with automatic fallbacks and runtime detection",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/portable.d.ts",
        "default": "./dist/core/portable.js"
      },
      "require": {
        "types": "./dist/cjs/core/portable.d.ts",
        "default": "./dist/cjs/core/portable.js"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/adapters/postgresAdapter.d.ts",
        "default": "./dist/adapters/postgresAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/postgresAdapter.d.ts",
        "default": "./dist/cjs/adapters/postgresAdapter.js"
      }
    },
    "./better-sqlite3": {
      "import": {
        "types": "./dist/adapters/betterSqliteAdapter.d.ts",
        "default": "./dist/adapters/betterSqliteAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/betterSqliteAdapter.d.ts",
        "default": "./dist/cjs/adapters/betterSqliteAdapter.js"
      }
    },
    "./sqljs": {
      "import": {
        "types": "./dist/adapters/sqlJsAdapter.d.ts",
        "default": "./dist/adapters/sqlJsAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/sqlJsAdapter.d.ts",
        "default": "./dist/cjs/adapters/sqlJsAdapter.js"
      }
    },
    "./indexeddb": {
      "import": {
        "types": "./dist/adapters/indexedDbAdapter.d.ts",
        "default": "./dist/adapters/indexedDbAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/indexedDbAdapter.d.ts",
        "default": "./dist/cjs/adapters/indexedDbAdapter.js"
      }
    },
    "./capacitor": {
      "import": {
        "types": "./dist/adapters/capacitorSqliteAdapter.d.ts",
        "default": "./dist/adapters/capacitorSqliteAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/capacitorSqliteAdapter.d.ts",
        "default": "./dist/cjs/adapters/capacitorSqliteAdapter.js"
      }
    },
    "./backup": {
      "import": {
        "types": "./dist/features/backup/cloudBackup.d.ts",
        "default": "./dist/features/backup/cloudBackup.js"
      },
      "require": {
        "types": "./dist/cjs/features/backup/cloudBackup.d.ts",
        "default": "./dist/cjs/features/backup/cloudBackup.js"
      }
    },
    "./authjs": {
      "import": {
        "types": "./dist/features/auth/authJsAdapter.d.ts",
        "default": "./dist/features/auth/authJsAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/features/auth/authJsAdapter.d.ts",
        "default": "./dist/cjs/features/auth/authJsAdapter.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/types/index.js"
      },
      "require": {
        "types": "./dist/cjs/types/index.d.ts",
        "default": "./dist/cjs/types/index.js"
      }
    },
    "./electron": {
      "import": {
        "types": "./dist/adapters/electron/index.d.ts",
        "default": "./dist/adapters/electron/index.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/electron/index.d.ts",
        "default": "./dist/cjs/adapters/electron/index.js"
      }
    },
    "./electron/renderer": {
      "import": {
        "types": "./dist/adapters/electron/renderer.d.ts",
        "default": "./dist/adapters/electron/renderer.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/electron/renderer.d.ts",
        "default": "./dist/cjs/adapters/electron/renderer.js"
      }
    },
    "./electron/preload": {
      "import": {
        "types": "./dist/adapters/electron/preload.d.ts",
        "default": "./dist/adapters/electron/preload.js"
      },
      "require": {
        "types": "./dist/cjs/adapters/electron/preload.d.ts",
        "default": "./dist/adapters/electron/preload.cjs"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/features/sync/index.d.ts",
        "default": "./dist/features/sync/index.js"
      },
      "require": {
        "types": "./dist/cjs/features/sync/index.d.ts",
        "default": "./dist/cjs/features/sync/index.js"
      }
    },
    "./kv": {
      "import": {
        "types": "./dist/features/kv/index.d.ts",
        "default": "./dist/features/kv/index.js"
      },
      "require": {
        "types": "./dist/cjs/features/kv/index.d.ts",
        "default": "./dist/cjs/features/kv/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "build": "npm run clean && npx tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs && node scripts/build-cjs.mjs",
    "prepare": "test -d dist || npm run build",
    "prepublishOnly": "npm run build && npm run test",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "npm run test:coverage",
    "coverage:view": "open coverage/index.html || start coverage/index.html || xdg-open coverage/index.html",
    "docs": "typedoc --out docs src/index.ts",
    "docs:clean": "rimraf docs",
    "docs:serve": "npx http-server docs -p 8080 -o"
  },
  "keywords": [
    "sql",
    "sqlite",
    "postgres",
    "postgresql",
    "database",
    "storage",
    "adapter",
    "abstraction",
    "capacitor",
    "sql.js",
    "better-sqlite3",
    "indexeddb",
    "typescript",
    "cross-platform",
    "fallback",
    "webassembly",
    "pwa",
    "offline-first",
    "agentos",
    "framers-agentos",
    "ai-agent-storage",
    "agent-memory-storage",
    "framers",
    "frame-dev"
  ],
  "author": "Framers (https://frame.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/framerslab/sql-storage-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/framerslab/sql-storage-adapter/issues",
    "email": "team@frame.dev"
  },
  "homepage": "https://framerslab.github.io/sql-storage-adapter/",
  "sideEffects": [
    "./dist/adapters/electron/preload.js",
    "./dist/adapters/electron/preload.cjs",
    "./dist/cjs/adapters/electron/preload.js"
  ],
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.709.0",
    "better-sqlite3": "^13.0.3",
    "electron": "^33.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.4",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.10.7",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "patch-package": "^8.0.0",
    "rimraf": "^5.0.7",
    "semantic-release": "^24.1.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.26.11",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.7",
    "@vitest/browser": "^3.2.7",
    "playwright": "~1.63.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "sql.js": "^1.11.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@capacitor-community/sqlite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "better-sqlite3": "^12.0.0 || ^13.0.0",
    "electron": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@capacitor-community/sqlite": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "electron": {
      "optional": true
    }
  }
}
